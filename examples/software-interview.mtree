tree software_interview "Software Engineering Interview"
@view tree

topic introduction_topic "Introduction"
  @text "Build a concise opening that connects your recent work to this role."
  @feature "Keep the opening under 90 seconds"
  question introduction "Tell me about yourself."
    @text "Cover present role, strongest relevant experience, and why this opportunity fits."
    @feature "Likely follow-up: What did you own?"
    response concise "Backend-focused introduction"
      @answer "I build reliable backend systems and most recently owned services from API design through production observability. I am now looking to apply that experience to a product where performance and clear engineering decisions matter."
      @feature "Present → evidence → role fit"
      @tag preferred
      @priority high
      followup ownership "What did you own in your most recent project?"
        @text "Be precise about personal responsibility rather than describing only the team."
        @feature "Probe: architecture trade-offs"
        response architecture "Service ownership and architecture"
          @answer "I owned the service boundaries, API contract, rollout plan, and production dashboards. I chose simpler synchronous boundaries first, then introduced asynchronous processing only where latency and retry behavior justified it."
          @feature "Evidence: design decision and trade-off"
          example latency "Mention the measurable latency and reliability improvements."
            @text "Use one before-and-after metric and explain how it was measured."
            @feature "Metric: p95 latency and error rate"
        response collaboration "Cross-team technical leadership"
          @answer "I turned the design into a short RFC, gathered feedback from dependent teams, and used code reviews and rollout checkpoints to keep the change understandable and reversible."
          @feature "Evidence: RFC, review, rollout"
    response technical "Systems-first introduction"
      @answer "I enjoy turning ambiguous product needs into observable services with clear contracts. My strongest work combines TypeScript, PostgreSQL, performance analysis, and pragmatic architecture."
      @feature "Use when the interviewer is highly technical"
      followup stack "Which technologies did you use?"
        @text "Name the tools, then explain why each mattered."
        @feature "Probe: why this stack?"
        response stack_answer "Technology choices"
          @answer "TypeScript and Node.js kept the API layer fast to iterate, PostgreSQL gave us reliable transactional behavior, and tracing plus service-level dashboards made production decisions evidence-based."
          @feature "Connect each tool to an outcome"

topic behavioral_topic "Behavioral questions"
  @text "Use compact STAR stories with one clear decision and measurable result."
  @feature "Prepare two primary stories and one backup"
  question challenge "Describe a difficult project."
    @text "Choose a challenge with uncertainty, meaningful responsibility, and a visible result."
    @feature "Likely follow-up: What changed?"
    response incident "Production performance incident"
      @answer "A production service began missing its latency objective under peak load. I isolated the bottleneck with traces, validated the database contention hypothesis, and coordinated a staged fix while keeping rollback safe."
      @feature "STAR: investigation and ownership"
      @tag backup
      followup result "What changed after your work?"
        @text "State the result first, then how you verified it remained stable."
        @feature "Probe: was the improvement sustained?"
        response measurable_result "Measured result"
          @answer "The change reduced p95 latency from 820 ms to 240 ms and cut timeout errors by 70%. We verified it through a gradual rollout and monitored the same indicators over the following weeks."
          @feature "Result: latency, errors, stability"
          note concise_note "Keep the result specific and concise."
            @text "Avoid adding implementation details unless the interviewer asks."
            @feature "Delivery target: 20 seconds"

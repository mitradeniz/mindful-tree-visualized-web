{
  "name": "branchscript",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:parser": "lezer-generator src/scripting/mindtree.grammar -o src/scripting/generated-parser.ts --typeScript",
    "prebuild": "npm run generate:parser",
    "build": "tsc --noEmit && vite build",
    "typecheck": "npm run generate:parser && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@antv/x6": "2.19.2",
    "@antv/x6-plugin-history": "2.2.4",
    "@antv/x6-plugin-keyboard": "2.2.3",
    "@antv/x6-plugin-minimap": "2.0.7",
    "@antv/x6-plugin-selection": "2.2.2",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@dagrejs/dagre": "3.1.1",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.10",
    "codemirror": "6.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lezer/generator": "1.8.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
